
BIG_STRIDE = 10000

processes = [
    {"pid": "P1", "tickets": 3, "pass": 0, "runs": 0},
    {"pid": "P2", "tickets": 2, "pass": 0, "runs": 0},
    {"pid": "P3", "tickets": 1, "pass": 0, "runs": 0},
]

for p in processes:
    p["stride"] = BIG_STRIDE // p["tickets"]

schedule = []

for _ in range(12):
    current = min(processes, key=lambda p: p["pass"])
    schedule.append(current["pid"])
    current["runs"] += 1
    current["pass"] += current["stride"]

print("STRIDE SCHEDULING")
print("-" * 25)

print("Execution order:")
print(" -> ".join(schedule))

print("\nProcess Statistics:")
print("PID | Tickets | Stride | Runs")

for p in processes:
    print(
        p["pid"], "|",
        p["tickets"], "|",
        p["stride"], "|",
        p["runs"]
    )

print("\nGANTT CHART:")
print(" | ".join(schedule))
print("-" * 40)

for i, pid in enumerate(schedule):
    print(f"{i}--{i+1}: {pid}")
